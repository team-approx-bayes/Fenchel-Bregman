# Copy this file to .env and fill in your values. .env is git-ignored.
# It is sourced by the SLURM jobs (slurm/_common.slurm) and the local
# launchers (fenchel_bregman/rrm/sh/_common.sh), so every evaluation run
# picks these up automatically.

# Weights & Biases project that evaluation runs log to.
WANDB_PROJECT=ptrm-ivon-eval

# Optional: wandb team/user (defaults to your `wandb login` account).
# WANDB_ENTITY=adrianrob1-Sapienza Università di Roma

# Optional: group runs together (e.g. a sweep name). Leave unset for none.
# WANDB_GROUP=

# Optional: log running metrics every N batches (default 1).
# WANDB_LOG_EVERY=1

# Optional: set to "disabled" to turn off wandb logging entirely.
# WANDB_MODE=
